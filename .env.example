# Локальный Node.js-сервер
PORT=3000
HOST=127.0.0.1

# Переходный мост для ещё не перенесённых действий
APPS_SCRIPT_URL=

# Supabase. На размещённой Edge Function эти значения предоставляет Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Google Drive и Google Docs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=

# Через запятую: адрес GitHub Pages и локальный адрес для разработки
ALLOWED_ORIGINS=

# Подтверждение почты и восстановление (включать после миграции account_email).
# Старые аккаунты сохраняются. Ключ сервиса хранится только на сервере.
AUTH_EMAIL_ENABLED=false
AUTH_EMAIL_PROVIDER=apps-script
AUTH_SITE_URL=https://xianbv.github.io/logovo_novel/
AUTH_MAIL_RELAY_URL=
AUTH_MAIL_RELAY_SECRET=
# Необязательный альтернативный транспорт Resend
AUTH_EMAIL_FROM=
RESEND_API_KEY=
